# Salin menjadi .env.mail.local. Jangan commit file berisi kredensial.
# Gmail/Google Workspace: gunakan Password Aplikasi, bukan password akun biasa.
# Isi MAIL_USER dan MAIL_FROM_ADDRESS dengan alamat pengirim yang diizinkan.
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_REQUIRE_TLS=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=jdih@ith.ac.id
MAIL_FROM_NAME=JDIH ITH Parepare
