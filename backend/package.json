{
  "name": "@jdih/api",
  "version": "1.0.0",
  "private": true,
  "description": "Peladen API Portal JDIH ITH Parepare (NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "debug": "nest start --debug --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:mysql:prepare": "node scripts/prepare-identity-test-db.mjs",
    "test:mysql": "vitest run src/modules/identity/identity.mysql.spec.ts src/modules/core-backend/core-backend.mysql.spec.ts",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "db:pull": "node ../scripts/db-pull.mjs",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "db:pull:mentah": "drizzle-kit pull"
  },
  "dependencies": {
    "@jdih/shared": "*",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "mysql2": "^3.24.4",
    "nestjs-pino": "^5.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.5",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
