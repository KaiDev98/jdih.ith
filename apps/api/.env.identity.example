# Copy to apps/api/.env.identity.local (gitignored). Never commit real credentials.
# DB_* loaded from repository .env.v2.local; DB_PORT has no assumed runtime value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/auth/google/callback
# Generate at least 32 random bytes, e.g. node crypto.randomBytes(32).toString('hex').
SESSION_KEY=
SESSION_TTL_SECONDS=604800
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
DB_LOG_QUERY=false
DB_TIMEZONE=Z
# Production requires HTTPS, Secure cookies and Swagger disabled.
SWAGGER_ENABLED=true
