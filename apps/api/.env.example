# LEGACY / INACTIVE CONFIGURATION — DO NOT USE FOR JDIH ITH V2.
# Retained as historical setup only. V2 reads apps/api/.env.identity.local and
# repository-root .env.v2.local. See apps/api/.env.identity.example and
# docs/DEPLOYMENT_V2.md. The JWT, XAMPP, and legacy database settings below are
# not the active application configuration.
# =============================================================================
#  PELADEN API — PORTAL JDIH ITH PAREPARE
# =============================================================================
#  Salin berkas ini menjadi ".env" pada direktori yang sama, lalu sesuaikan.
#  Tiga rahasia di bawah WAJIB diganti; jalankan perintah ini untuk membangkitkan:
#
#      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
#  Peladen menolak menyala bila ada nilai yang kurang atau salah bentuk, dan
#  akan menyebutkan variabel mana yang bermasalah.
# =============================================================================

# ── Aplikasi ─────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_HOST=0.0.0.0
API_PREFIX=api/v1
# Asal aplikasi web yang diizinkan memanggil API. Pisahkan dengan koma.
CORS_ORIGIN=http://localhost:3000
# Alamat portal, dipakai pada tautan di dalam surel dan sitemap.
APP_URL=http://localhost:3000

# ── Basis data ───────────────────────────────────────────────────────────────
#  Pada XAMPP baku: DB_USER=root dan DB_PASSWORD dibiarkan kosong.
#  Nyalakan MySQL dari XAMPP Control Panel sebelum menjalankan peladen.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jdih_ith
DB_POOL_LIMIT=10
# Seluruh DATETIME disimpan dalam UTC; "Z" menjaga koneksi tidak menggesernya.
DB_TIMEZONE=Z
# Mencetak setiap kueri ke log. Berguna saat menelusuri masalah, berisik sehari-hari.
DB_LOG_QUERY=false

# ── Autentikasi ──────────────────────────────────────────────────────────────
#  GANTI ketiga nilai ini. Ketiganya harus berbeda satu dari yang lain.
JWT_SECRET=ganti-dengan-rahasia-acak-minimum-32-karakter
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ganti-dengan-rahasia-acak-lain-minimum-32-karakter
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=ganti-dengan-rahasia-acak-ketiga-minimum-32-karakter

# ── Penyimpanan berkas dokumen ───────────────────────────────────────────────
#  "lokal" menyimpan di diska peladen — cukup untuk pengembangan dan penggelaran
#  satu peladen. Beralih ke "s3" bila memakai penyimpanan objek (MinIO/S3).
STORAGE_DRIVER=lokal
STORAGE_LOCAL_PATH=./storage/dokumen
# Umur tautan unduhan bertanda tangan, dalam detik.
STORAGE_SIGNED_URL_TTL=300
UPLOAD_MAX_SIZE_MB=50

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Pencarian ────────────────────────────────────────────────────────────────
#  "mysql" memakai indeks FULLTEXT bawaan: tanpa layanan tambahan, sudah cukup
#  untuk memulai. Beralih ke "meilisearch" bila kualitas penelusuran perlu
#  ditingkatkan (toleransi salah ketik, sinonim, peringkat relevansi).
SEARCH_DRIVER=mysql
MEILISEARCH_HOST=
MEILISEARCH_API_KEY=

# ── Cache ────────────────────────────────────────────────────────────────────
#  "memori" cukup untuk satu proses. Wajib "redis" bila menjalankan lebih dari
#  satu proses, karena cache izin harus dibagi bersama.
CACHE_DRIVER=memori
REDIS_URL=

# ── Surel ────────────────────────────────────────────────────────────────────
#  "log" hanya mencetak isi surel ke log — aman dan praktis saat pengembangan,
#  tidak ada surel yang benar-benar terkirim ke pengguna sungguhan.
MAIL_DRIVER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=jdih@ith.ac.id
MAIL_FROM_NAME=JDIH ITH Parepare

# ── Pembatasan laju ──────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=120
# Batas unduhan per jam (docs/05-role-permission.md § E.7 butir 8).
UNDUH_LIMIT_ANONIM=30
UNDUH_LIMIT_PENGGUNA=200

# ── Pencatatan ───────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ── Dokumentasi API ──────────────────────────────────────────────────────────
#  Wajib false di produksi: dokumentasi terbuka memudahkan pemetaan permukaan serang.
SWAGGER_ENABLED=true

# ── Integrasi luar (aktifkan bila sudah tersedia) ────────────────────────────
JDIHN_ENABLED=false
JDIHN_API_URL=
JDIHN_API_KEY=

SSO_ENABLED=false
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
