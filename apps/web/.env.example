# Alamat peladen API dilihat DARI PROSES NEXT (bukan dari peramban).
# Dipakai komponen peladen saat merender halaman, dan oleh penerusan /api/v1.
API_INTERNAL_URL=http://localhost:3001

# Alamat publik portal. Dipakai untuk metadata Open Graph, sitemap.xml, dan
# tautan kanonis pada halaman dokumen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nama yang tampil pada tajuk dan judul halaman.
NEXT_PUBLIC_NAMA_SITUS=JDIH ITH Parepare
NEXT_PUBLIC_NAMA_INSTITUSI=Institut Teknologi Bacharuddin Jusuf Habibie
