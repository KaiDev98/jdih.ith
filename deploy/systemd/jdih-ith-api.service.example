[Unit]
Description=JDIH ITH V2 NestJS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jdih
Group=jdih
WorkingDirectory=/srv/jdih-ith/current/backend
EnvironmentFile=/etc/jdih-ith/api.env
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
